apiVersion: apps/v1
kind: Deployment
metadata:
  name: cf-all-right-home-backend
  namespace: cloudflared
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cf-all-right-home-backend
  template:
    metadata:
      labels:
        app: cf-all-right-home-backend
    spec:
      containers:
        - name: cloudflared
          image: cloudflare/cloudflared:latest
          args:
            - tunnel
            - --no-autoupdate
            - --protocol
            - http2
            - --url
            - http://all-right-home-backend.apps.svc.cluster.local:80
          resources:
            requests:
              cpu: 25m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 256Mi
